{% extends 'base.html.twig' %}

{% block title %}Connexion — Espace Personnel{% endblock %}

{% block body %}
<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0">🔑 Connexion Espace Personnel</h4>
            </div>
            <div class="card-body p-4">
                {% if error %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info mb-3">
                        Vous êtes déjà connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>. 
                        <a href="{{ path('app_logout') }}" class="alert-link">Se déconnecter</a>
                    </div>
                {% else %}
                    <form method="post">
                        <div class="mb-3">
                            <label for="inputEmail" class="form-label fw-bold">Adresse e-mail</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="agent@agence.fr">
                        </div>

                        <div class="mb-3">
                            <label for="inputPassword" class="form-label fw-bold">Mot de passe</label>
                            <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="••••••••">
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button class="btn btn-primary w-100 py-2 mt-2" type="submit">
                            Se connecter
                        </button>
                    </form>
                {% endif %}
            </div>
            <div class="card-footer text-center text-muted py-3">
                Espace réservé au personnel (`ROLE_STAFF`) et aux administrateurs (`ROLE_ADMIN`).
            </div>
        </div>
    </div>
</div>
{% endblock %}